# Settings of the awa containers (awa-serve, awa-worker, awa-mcp). Copy to deploy/awa.env and
# fill in; an endpoint whose bearer key is empty does not start. Generate keys and secrets with
# python -c "import secrets; print(secrets.token_urlsafe(32))".
# Every name is described in docs/reference/settings.md.
# The database address, the Langfuse address and keys are set in compose.yaml from deploy/.env.

AWA_ENV=production

# Bearer key callers of the HTTP API send (awa serve --api-key-env AWA_API_KEY)
AWA_API_KEY=
# Bearer key of the MCP endpoint (profile mcp only)
AWA_MCP_API_KEY=

# Required with PostgreSQL: links people to their runs (erasure per person). Same value in
# every process, keep it stable.
AWA_PSEUDONYM_KEY=
# Keeps provider prompt-cache keys stable across processes
AWA_CACHE_SALT=

# Model provider: fill in ONE block.
# Anthropic
#ANTHROPIC_API_KEY=
#AWA_DEFAULT_MODEL=anthropic:<model>

# Azure OpenAI with a key
#AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
#AZURE_OPENAI_API_KEY=
#AZURE_OPENAI_DEPLOYMENT_NAME=<your-deployment>
#AWA_DEFAULT_MODEL=azure_openai:<your-deployment>
# Azure OpenAI with Microsoft Entra ID instead of a key
#AZURE_OPENAI_AUTH=entra
#AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
#AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
#AZURE_CLIENT_SECRET=

# Microsoft 365 connectors (only when the blueprint uses them)
#MS_MAILBOX=shared-mailbox@example.internal
#MS_SITE_URL=https://<tenant>.sharepoint.com/sites/<site>

# Limits of every run tree that sets none of its own (defaults shown)
#AWA_RUN_MAX_REQUESTS=400
#AWA_RUN_MAX_TOOL_CALLS=200
#AWA_RUN_MAX_TOKENS=1000000
#AWA_RUN_MAX_SECONDS=3600
#AWA_TOOL_PROFILE=cost

# Unknown AWA_* names stop the start instead of warning
AWA_STRICT_SETTINGS=true

# Outbound proxy, if the network requires one (read by the model SDKs; connectors use it only
# with their option use_env_proxies: true)
#HTTPS_PROXY=http://proxy.example.internal:8080
#NO_PROXY=localhost,127.0.0.1,postgres,caddy,.example.internal
