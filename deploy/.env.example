# Values Docker Compose substitutes into compose.yaml. Copy to deploy/.env and fill in every
# empty value. Generate passwords with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Never commit deploy/.env.

# Host names on the certificate in deploy/certs/tls.crt
AWA_PUBLIC_HOST=awa.example.internal
LANGFUSE_INTERNAL_HOST=langfuse.example.internal

# User id and group id the awa containers run as (owner of the mounted project folder)
AWA_UID=10001
AWA_GID=10001

# awa's PostgreSQL
POSTGRES_PASSWORD=

# Langfuse project keys, any pair you choose that starts with pk-lf- and sk-lf-: awa sends with
# them, Langfuse creates the project with them on first start
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Langfuse infrastructure (only the Langfuse containers receive these)
LANGFUSE_ADMIN_EMAIL=admin@example.internal
LANGFUSE_ADMIN_PASSWORD=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
# 64 hexadecimal characters: python -c "import secrets; print(secrets.token_hex(32))"
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_DB_PASSWORD=
LANGFUSE_CLICKHOUSE_PASSWORD=
LANGFUSE_REDIS_PASSWORD=
LANGFUSE_MINIO_PASSWORD=

# Send every run to the self-hosted Langfuse (true needs deploy/compose.tracing.yaml)
AWA_LANGFUSE_TRACING=false
