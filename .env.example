# awa configuration. Copy to .env and fill in what you use; never commit .env.
# Generated from the settings registry by scripts/gen_settings.py: do not edit by hand.
#
# A value is taken from the environment, else from this project's .env, else the
# default. Every awa command reads the .env of the project folder (the folder with
# blueprint.yaml, pyproject.toml [tool.awa] or .awa/). An empty value counts as unset,
# so every line below may stay empty; fill in only what you use.
# Secrets are never printed: awa env list and awa doctor show only whether they are set.
# awa setup writes these values for you. Reference: docs/reference/settings.md

# --- Model profiles ----------------------------------------------------------
# Model of the `default` profile (`provider:model`). Unset: chosen from the provider whose credentials are set. Default: anthropic:claude-sonnet-5-5.
AWA_DEFAULT_MODEL=
# Model of the `fast` profile. Unset: chosen from the provider whose credentials are set. Default: anthropic:claude-haiku-5-5.
AWA_FAST_MODEL=
# Model of the `strong` profile. Unset: chosen from the provider whose credentials are set. Default: anthropic:claude-opus-5-5.
AWA_STRONG_MODEL=
# Send OpenAI and Azure OpenAI reasoning models that get an effort (judge and reviewer `low`, worker `medium`) through the Responses API, the API that takes an effort together with tools, with `store=False` (no response kept by the provider; the reasoning travels encrypted). `false`: Chat Completions without an effort. A model's own `use_responses_api` or `store` setting wins. Default: false.
AWA_OPENAI_RESPONSES_API=
# Model that reads scanned PDF pages (a profile or `provider:model`, e.g. `fast`). Unset: the `default` profile; the workspace `ocr` option overrides it.
AWA_VISION_MODEL=

# --- Anthropic ---------------------------------------------------------------
# API key for `anthropic:` models.
ANTHROPIC_API_KEY=
# Bearer token used instead of the API key (read by the Anthropic SDK).
ANTHROPIC_AUTH_TOKEN=
# Another address for the Anthropic API, for example a gateway.
ANTHROPIC_BASE_URL=
# Extra HTTP headers the Anthropic SDK sends.
ANTHROPIC_CUSTOM_HEADERS=

# --- OpenAI ------------------------------------------------------------------
# API key for `openai:` models.
OPENAI_API_KEY=
# OpenAI organization id.
OPENAI_ORG_ID=
# OpenAI project id.
OPENAI_PROJECT_ID=
# Another address for the OpenAI API, for example a gateway.
OPENAI_BASE_URL=
# Extra HTTP headers the OpenAI SDK sends.
OPENAI_CUSTOM_HEADERS=

# --- Azure OpenAI ------------------------------------------------------------
# API key for `azure_openai:` models (with AZURE_OPENAI_AUTH=key).
AZURE_OPENAI_API_KEY=
# The Azure OpenAI resource, for example `https://<resource>.openai.azure.com/`.
AZURE_OPENAI_ENDPOINT=
# The deployment every `azure_openai:` model uses.
AZURE_OPENAI_DEPLOYMENT_NAME=
# Deployment of the `fast` profile when Azure is chosen automatically (default: AZURE_OPENAI_DEPLOYMENT_NAME).
AZURE_OPENAI_DEPLOYMENT_FAST=
# Deployment of the `strong` profile when Azure is chosen automatically (default: AZURE_OPENAI_DEPLOYMENT_NAME).
AZURE_OPENAI_DEPLOYMENT_STRONG=
# A dated Azure OpenAI API version. Unset: the v1 API, which needs none.
OPENAI_API_VERSION=
# `key` (the API key) or `entra` (a Microsoft Entra ID service principal). Default: key.
AZURE_OPENAI_AUTH=

# --- Microsoft Entra ID and Microsoft 365 (Outlook, SharePoint and Excel, Teams) ----
# Directory (tenant) ID of the one app registration (Entra admin center > App registrations > Overview), also for Azure OpenAI with AZURE_OPENAI_AUTH=entra. Permission: none itself; each service below names its own.
AZURE_TENANT_ID=
# Application (client) ID (a GUID) of that app. Permission: none itself; its API permissions are listed per service below. Check everything with `awa check microsoft`. Finding people (`awa people`, role: recipients): application User.Read.All with admin consent.
AZURE_CLIENT_ID=
# A client secret of the app: Certificates & secrets > Client secrets, copy the VALUE, not the Secret ID. Permission: none itself. Not needed with a certificate.
AZURE_CLIENT_SECRET=
# Recommended instead of a secret: a PEM file with the private key and the certificate, or a .pfx/.p12 file, whose public part is uploaded under Certificates & secrets > Certificates; it wins over AZURE_CLIENT_SECRET. Permission: none itself. Needs pip install "awa-agents[m365]".
AZURE_CLIENT_CERTIFICATE_PATH=
# The password of that key file, if it has one. Permission: none.
AZURE_CLIENT_CERTIFICATE_PASSWORD=
# Entra sign-in host, only for sovereign clouds or a local test server (default `https://login.microsoftonline.com`). Permission: none.
AZURE_AUTHORITY_HOST=
# Microsoft Graph host, only for sovereign clouds or a local test server (default `https://graph.microsoft.com`). Permission: none.
MS_GRAPH_URL=
# Outlook: the ONE mailbox the process works in (a shared mailbox works too). Permission: application Mail.ReadWrite (plus Mail.Send only to send), limited to this mailbox with Exchange RBAC for Applications; then remove the tenant-wide Mail.* consent.
MS_MAILBOX=
# SharePoint and Excel: the ONE site, such as `https://company.sharepoint.com/sites/sales`. Permission: application Sites.Selected, then an administrator grants 'read' or 'write' on this site.
MS_SITE_URL=
# awa check: the workbook (path in the site's library) the Excel check reads (default: the first .xlsx at the top). Permission: as MS_SITE_URL.
MS_CHECK_WORKBOOK=
# Teams: a Workflows webhook (Teams > channel menu > Workflows > 'Send webhook alerts to a channel'; the whole link with sig=). Permission: none in Entra; the link itself is the secret.
TEAMS_WEBHOOK_URL=
# Teams as a signed-in user (`awa connect microsoft --teams`): the ONE team the agents may use (the groupId= part of the team's link). Permission: delegated ChannelMessage.Send, ChannelMessage.Read.All and User.Read; the user is a member.
TEAMS_TEAM_ID=
# The ONE channel of that team (19:...@thread.tacv2, from the channel's link). Permission: as TEAMS_TEAM_ID.
TEAMS_CHANNEL_ID=
# awa check: a mailbox the app must NOT be able to read; the check expects 403 (empty skips the negative test). Permission: none.
AWA_CHECK_NEGATIVE_MAILBOX=
# awa check: `teams` lets it post ONE test card; empty: it never posts. Permission: as TEAMS_WEBHOOK_URL or the Teams user.
AWA_CHECK_ALLOW_POST=

# --- Other model providers ---------------------------------------------------
# API key for `google_genai:` models.
GOOGLE_API_KEY=
# API key for `google_genai:` models when GOOGLE_API_KEY is unset.
GEMINI_API_KEY=
# API key for `mistralai:` models.
MISTRAL_API_KEY=
# API key for `groq:` models.
GROQ_API_KEY=
# Where Ollama listens, for example `http://localhost:11434` (`ollama:` models).
OLLAMA_HOST=

# --- Storage and runs --------------------------------------------------------
# PostgreSQL database of runs, queues, checkpoints and stores (postgresql://user:password@host:5432/db). Unset: files next to the blueprint.
AWA_POSTGRES_DSN=
# Direct PostgreSQL connection (not through PgBouncer) for setup locks. Unset: AWA_POSTGRES_DSN.
AWA_POSTGRES_ADMIN_DSN=
# Connections of the one PostgreSQL pool each process shares. Default: 10.
AWA_POSTGRES_POOL_MAX=
# `pgbouncer` when connections go through PgBouncer's transaction pooling (then no prepared statements). Default: none.
AWA_POSTGRES_POOLER=
# Where runs, steps and results are kept: `sqlite` (.awa/awa.db) or `postgres`. Unset: `postgres` when AWA_POSTGRES_DSN is set. `awa store use` changes it.
AWA_DATA_BACKEND=
# Keep prompts, answers and tool bodies of process runs (read only by the auditor role). Off: only their length. Default: false.
AWA_CAPTURE_CONTENT=
# Days a finished process run is kept before `awa store sweep` deletes it. Unset: kept until deleted.
AWA_RUN_RETENTION_DAYS=
# Secret that links people to their runs as an HMAC, for erasure per person (written into .env on first local use).
AWA_PSEUDONYM_KEY=
# Version of AWA_PSEUDONYM_KEY, kept with each link. Default: 1.
AWA_PSEUDONYM_KEY_ID=
# Checkpointer of `awa.persistence.open_checkpointer` (library use; the CLI chooses its own). Default: memory.
AWA_CHECKPOINTER_BACKEND=
# File of the `sqlite` checkpointer (default .awa/checkpoints.db).
AWA_CHECKPOINTER_PATH=
# Artifact repository of `awa.persistence.open_artifact_repository`. Default: memory.
AWA_ARTIFACT_BACKEND=
# Folder of the `file` artifact backend (default .awa_artifacts).
AWA_ARTIFACT_DIR=
# Store of `awa.persistence.open_store`. Default: memory.
AWA_STORE_BACKEND=

# --- Automations and triggers ------------------------------------------------
# How much each process run's trace records (default summary; `full` keeps message texts).
AWA_TRACE_LEVEL=
# Default user name of a mailbox trigger without `username_env`.
AWA_IMAP_USER=
# Default password (an app password) of a mailbox trigger without `password_env`.
AWA_IMAP_PASSWORD=
# Signing secret of job callbacks, when a callback names it in `secret_env`.
AWA_HOOK_SECRET=

# --- Server ------------------------------------------------------------------
# API key callers of `awa serve --api-key-env AWA_API_KEY` must send.
AWA_API_KEY=
# API key callers of `awa mcp serve --api-key-env AWA_MCP_API_KEY` must send.
AWA_MCP_API_KEY=
# Extra Host names (comma-separated) `awa serve` answers besides its own; `--allowed-host` replaces them.
AWA_ALLOWED_HOSTS=
# Log level an application reads as `Settings.log_level`; awa itself sets no log level. Default: INFO.
AWA_LOG_LEVEL=
# Deployment label, attached as the `env:<env>` trace tag; changes no behavior. Default: local.
AWA_ENV=

# --- Tracing and observability -----------------------------------------------
# Send LangChain runs to LangSmith. Default: false.
LANGSMITH_TRACING=
# LangSmith API key.
LANGSMITH_API_KEY=
# LangSmith project name.
LANGSMITH_PROJECT=
# Another LangSmith server.
LANGSMITH_ENDPOINT=
# Send every run of the awa commands to Langfuse (needs the `langfuse` extra). Default: false.
AWA_LANGFUSE_TRACING=
# Stop a command when Langfuse tracing cannot start (off: warn once, run without it). Default: false.
AWA_LANGFUSE_STRICT=
# Seconds one span export or score request to Langfuse may take; a failed one is tried again with backoff, then its spans are dropped with one warning. Default: 30.0.
AWA_TRACE_EXPORT_TIMEOUT=
# Also send prompts, replies and tool data, redacted (off: names, ids, tokens, cost, timing). Default: false.
AWA_LANGFUSE_CAPTURE_CONTENT=
# Langfuse public key.
LANGFUSE_PUBLIC_KEY=
# Langfuse secret key.
LANGFUSE_SECRET_KEY=
# Langfuse server (default: Langfuse Cloud, EU).
LANGFUSE_BASE_URL=
# Release shown on every Langfuse trace, for example a git tag.
LANGFUSE_RELEASE=
# Langfuse environment of every trace (`development`, `production`, ...).
LANGFUSE_TRACING_ENVIRONMENT=

# --- Workspace ---------------------------------------------------------------
# The workspace folder of the `workspace` connector (default data).
AWA_WORKSPACE_DIR=
# SQLite file in the workspace folder.
AWA_WORKSPACE_DB=

# --- Caching -----------------------------------------------------------------
# Master switch of every awa cache; the AWA_CACHE_* values win over a blueprint's `defaults.cache`.
AWA_CACHE_ENABLED=
# Provider prompt caching: `auto`, `off` or `1h`.
AWA_CACHE_PROMPT=
# Lengthen an OpenAI/Azure prompt prefix that is just short of the 1,024-token caching minimum, so repeated calls read it from the cache (default on).
AWA_CACHE_PROMPT_PAD=
# Reuse the results of read-only tools.
AWA_CACHE_TOOLS=
# Seconds a read-only tool result is kept across runs (unset: for one run).
AWA_CACHE_TOOLS_TTL=
# Reuse deterministic process steps.
AWA_CACHE_STEPS=
# Where the caches are kept: `memory` or `sqlite`.
AWA_CACHE_STORE=
# File of the `sqlite` cache store (default .awa/cache.db).
AWA_CACHE_PATH=
# Project secret that makes the cache keys sent to a provider opaque and stable (`awa cache salt` writes one).
AWA_CACHE_SALT=

# --- Run limits and loop protection ------------------------------------------
# Model calls one run tree may make when its `UsageLimits` set no `max_requests` (a whole number; a ceiling cannot be switched off, only raised). Default: 400.
AWA_RUN_MAX_REQUESTS=
# Tool calls one run tree may make when its `UsageLimits` set no `max_tool_calls`. Default: 200.
AWA_RUN_MAX_TOOL_CALLS=
# Input plus output tokens one run tree may use when its `UsageLimits` set no `max_total_tokens`. Default: 1000000.
AWA_RUN_MAX_TOKENS=
# Wall-clock seconds of a run tree that has no `timeout` and no `UsageLimits.max_duration`. Default: 3600.
AWA_RUN_MAX_SECONDS=
# How deep runs may nest (agents delegating to or calling agents); the top-level run has depth 0. Default: 16.
AWA_RUN_MAX_DEPTH=
# Model calls one team delegation may make, its own delegations included, when `TeamLimits.delegation_limits` is not set; beyond it only that delegation stops. Default: 50.
AWA_DELEGATION_MAX_REQUESTS=
# Identical tool calls (same tool, arguments and result) in one agent run before the run is stopped for making no progress (at least 2). Default: 5.
AWA_MAX_IDENTICAL_CALLS=
# Failures in a row of one tool in one agent run before the run is stopped for making no progress. Default: 5.
AWA_MAX_TOOL_ERRORS=
# Identical results in a row after which a `Loop` stops, and identical drafts after which a `Checked` revision stops (at least 2). Default: 2.
AWA_MAX_IDENTICAL_OUTPUTS=
# Pages one connector list call reads before it returns a `next_page` to continue. Default: 20.
AWA_MAX_PAGES_PER_CALL=
# Defaults of the tool layer: `cost` (results above 6,000 characters saved aside with a preview, clearing from 10,000 tokens) or `quality` (results cut at 40,000 characters, clearing from 40,000 tokens). Default: cost.
AWA_TOOL_PROFILE=
# Longest text result a tool hands to the model; unset: the profile's value. In the `cost` profile a longer result is saved aside and the model gets a preview and a reference it can read on with `read_tool_result`.
AWA_TOOL_MAX_OUTPUT_CHARS=
# Failures in a row after which a tool answers 'unavailable in this run' without being called (0: never). Default: 3.
AWA_TOOL_CIRCUIT_BREAKER=
# Retries, with jittered backoff, of a call of a tool that does not act outside the agent and raised a network error. Default: 2.
AWA_TOOL_RETRIES=
# Replace older tool results with a short note naming the call in what the model sees once a request grows past `AWA_CONTEXT_EDITING_TRIGGER` (the run's state keeps them). Default: true.
AWA_CONTEXT_EDITING=
# Approximate request size in tokens above which older tool results are cleared; unset: the profile's value (10,000 or 40,000).
AWA_CONTEXT_EDITING_TRIGGER=
# Most recent tool results that are never cleared (up to keep + step - 1 stay); unset: the profile's value (3 or 4).
AWA_CONTEXT_EDITING_KEEP=
# Tool results cleared together, so the cached prompt prefix changes only every few calls. Default: 4.
AWA_CONTEXT_EDITING_STEP=
# Fewest tokens a clearing step must free, else nothing is cleared (a clearing costs one prompt-cache miss); unset: the profile's value (3,000 or 0).
AWA_CONTEXT_EDITING_CLEAR_AT_LEAST=
# Lost worker leases in a row (a worker crashed or hung on the run) after which an automation run is dead-lettered instead of taken over again. Default: 3.
AWA_MAX_LEASE_LOSSES=

# --- General -----------------------------------------------------------------
# Stop with exit code 78 on an unknown AWA_* name or an unconfirmed security switch. Default: false.
AWA_STRICT_SETTINGS=
