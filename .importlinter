# Import contracts of the awa package, checked by `lint-imports` (import-linter) and by
# tests/architecture/test_import_contracts.py.
#
# The layers run from the top (may import everything below) to the bottom (imports nothing
# above). Siblings joined by `|` are independent of each other; siblings joined by `:` may
# import each other.
# Imports inside functions count; imports under `if TYPE_CHECKING:` do not.
#
# Each `ignore_imports` list is the recorded baseline: an import listed there is a known
# violation that may only disappear. A new violation breaks the contract, and so does a listed
# import that no longer exists (delete its line in the same commit).

[importlinter]
root_packages =
    awa
exclude_type_checking_imports = True
contract_types =
    private_modules: tests.architecture.import_contracts.PrivateModulesContract
    outer_boundary: tests.architecture.outer_contract.OuterBoundaryContract

[importlinter:contract:layers]
name = Layers (interfaces, compiler, integrations, orchestration, runtime, foundation; top to bottom)
type = layers
layers =
    awa.cli : awa.checks : awa.__main__
    awa.testing
    awa.ui | awa.project_setup
    awa.server
    awa.automation | awa.people
    awa.exporter | awa.ext
    awa.blueprints : awa.quick
    awa.refine
    awa.evals
    awa.connectors | awa.data
    awa.toolkits | awa.mcp
    awa.team
    awa.workflows
    awa.tasks | awa.messaging
    awa.directory
    awa.agents : awa.guardrails
    awa.memory | awa.skills
    awa.tools
    awa.persistence
    awa.observability
    awa.models
    awa.runtime
    awa.plugins
    awa.config : awa.core
    awa.contracts
    awa._compat : awa._internal
    awa.errors
    awa.kernel
ignore_imports =
    awa.blueprints._automation -> awa.automation.templates
    awa.blueprints._project_files -> awa.automation.templates
    awa.blueprints.triggers -> awa.automation.blueprint
    awa.blueprints.triggers -> awa.automation.queues
    awa.connectors._saas_microsoft_outlook -> awa.people
    awa.connectors._saas_microsoft_outlook -> awa.people._connect
    awa.connectors._saas_microsoft_teams -> awa.people
    awa.connectors._saas_microsoft_teams -> awa.people._connect

[importlinter:contract:private]
name = A package's private modules are imported only from inside that package
type = private_modules
shared =
    awa._compat
    awa._internal
ignore_imports =
    awa.agents.agent -> awa.runtime._run
    awa.agents.graph_agent -> awa.runtime._run
    awa.agents.graph_agent -> awa.runtime._streaming
    awa.automation.automation -> awa.runtime._run
    awa.automation.blueprint -> awa.blueprints._automation
    awa.blueprints._build_process -> awa.workflows._step_checks
    awa.blueprints._check -> awa.connectors._catalog
    awa.blueprints._check_data -> awa.data._validate
    awa.blueprints._check_process -> awa.data._validate
    awa.blueprints._connect -> awa.connectors._catalog
    awa.blueprints._data_files -> awa.data._paths
    awa.blueprints._data_map -> awa.connectors._catalog
    awa.blueprints._data_project -> awa.data._paths
