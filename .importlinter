# The outer parts build on the core: the automation and serving stack, the web app, the builder
# modules of blueprints, the people directory, the connectors and checks for Microsoft 365, the
# agent network and the contract suites of the application backends. An entry names a module and
# everything below it; an entry ending in `*` is a name prefix. Every other module is core and
# imports none of them. This boundary is about dependencies, not stability: which parts are
# preview is set by `__stability__` and docs/about/version-plan.md.
[importlinter:contract:outer]
name = The core never imports an outer part
type = outer_boundary
resolve_lazy_imports = True
outer =
    awa.automation
    awa.checks
    awa.people
    awa.server
    awa.ui
    awa.project_setup.data_store
    awa.team.network
    awa.team._network_*
    awa.connectors._microsoft_*
    awa.connectors._saas_microsoft*
    awa.connectors._sharepoint_excel
    awa.blueprints._brief
    awa.blueprints._build_loop
    awa.blueprints._catalog
    awa.blueprints._connect
    awa.blueprints._data_design
    awa.blueprints._data_files
    awa.blueprints._data_map
    awa.blueprints._declare
    awa.blueprints._fit
    awa.blueprints._patterns
    awa.blueprints._project*
    awa.blueprints._refine_stage
    awa.blueprints._run_data
    awa.blueprints._systems
    awa.blueprints.architect
    awa.blueprints.ports
    awa.blueprints.triggers
    awa.blueprints.wizard
    awa.cli._automation
    awa.cli._brief
    awa.cli._check
    awa.cli._data*
    awa.cli._people
    awa.cli._serve
    awa.cli._setup
    awa.cli._store
    awa.cli._ui
    awa.testing.people_contract
    awa.testing.contracts.build_store
    awa.testing.contracts.event_queue
    awa.testing.contracts.file_store
    awa.testing.contracts.notifier
    awa.testing.contracts.run_store
    awa.testing.contracts.upload_store
ignore_imports =
    awa.blueprints._automation -> awa.automation.templates
    awa.blueprints._build -> awa.team.network
    awa.blueprints._check -> awa.blueprints.triggers
    awa.blueprints._check_data -> awa.blueprints._project_data
    awa.blueprints._data_project -> awa.blueprints._project_data
    awa.blueprints._schema_data -> awa.blueprints.ports
    awa.cli._add -> awa.blueprints.triggers
    awa.cli._blueprint -> awa.blueprints._connect
    awa.cli._blueprint -> awa.blueprints._declare
    awa.cli._blueprint -> awa.blueprints.triggers
    awa.cli._blueprint -> awa.checks.connect
    awa.cli._mcp -> awa.server.mcp
    awa.cli._new -> awa.blueprints.wizard
    awa.cli._preflight -> awa.automation.blueprint
    awa.cli._preflight -> awa.automation.queues
