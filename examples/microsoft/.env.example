# Copy this file to .env in YOUR process folder and fill it in; never put real values in this example.
# Step by step, with every click: docs/guide/microsoft-365.md
#
# The model the agents use (see docs/develop/models.md for the format and the Azure variables).
AWA_DEFAULT_MODEL=

# The app registration in Microsoft Entra ID (the same three names Azure OpenAI uses with Entra).
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# The ONE mailbox the process works in (a shared mailbox works too), and the ONE SharePoint site.
# The model never chooses either: they are not tool arguments.
MS_MAILBOX=
MS_SITE_URL=
