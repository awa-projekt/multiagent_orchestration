"""The `{{name}}` connector: how awa reaches your system over HTTP, and what it can do there.

Generated by `awa new connector`. Fill in the address, the authentication and the operations
of your API. Agents then use it as `connector:{{name}}` in a blueprint. The values come from
environment variables (`.env`), never from this file.

Test it with `pytest tests/test_{{name}}_connector.py`. Register it by adding
`register("connectors", "{{name}}", CONNECTOR, replace=True)` to the project's `plugins.py`.
"""

from __future__ import annotations

from awa.connectors import BearerAuth, ConnectorSpec, EnvVar, Operation, Param

CONNECTOR = ConnectorSpec(
    name="{{name}}",
    title="{{title}}",
    category="data",
    summary="Reads records from {{title}}.",
    base_url="{{{env}}_URL}",
    env=(EnvVar("{{env}}_URL", "Address of the {{title}} API.", secret=False),),
    auth=(BearerAuth(EnvVar("{{env}}_TOKEN", "API token of {{title}}.")),),
    operations=(
        Operation(
            "get_record",
            "Read one record by its id.",
            path="/records/{record_id}",
            params=(Param("record_id", "The id of the record.", location="path", required=True),),
        ),
    ),
)

__all__ = ["CONNECTOR"]
