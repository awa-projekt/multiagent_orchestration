"""The `{{name}}` toolbox: searches and creates records kept in a JSON file.

Generated by `awa new toolbox`. The fields are the configuration (validated
once, never shown to the model); every `@tool_method` becomes a tool named
`{{name}}_<method>`. Credentials for a system belong in `SecretStr` fields read
from the environment with `env_field`, so they never appear in a repr or a log.

    agent = Agent("assistant", tools={{class_name}}(path=Path("records.json")).tools())

Test it with `pytest tests/test_{{name}}.py`.
"""

from __future__ import annotations

import json
from pathlib import Path

from awa.tools import Toolbox, tool_method


class {{class_name}}(Toolbox, prefix="{{name}}"):
    """Records of {{name}}: a JSON list of `{"id", "title"}` objects in `path`."""

    path: Path = Path("{{name}}_records.json")
    max_results: int = 5

    @tool_method(risk=["private_data"], timeout=10)
    async def search(self, query: str) -> list[dict[str, str]]:
        """Search records by text. Use it before creating a record.

        Args:
            query: Words to look for in the record titles.
        """

        found = [item for item in self._records() if query.lower() in item["title"].lower()]
        return found[: self.max_results]

    @tool_method(approval=True, risk=["external_action"], timeout=10)
    async def create(self, title: str) -> str:
        """Create a record. A human approves every call.

        Args:
            title: Title of the new record.
        """

        records = self._records()
        record_id = f"N-{len(records) + 1}"
        records.append({"id": record_id, "title": title})
        self.path.write_text(json.dumps(records, indent=2), encoding="utf-8")
        return f"Created {record_id}."

    def _records(self) -> list[dict[str, str]]:
        if not self.path.is_file():
            return []
        records: list[dict[str, str]] = json.loads(self.path.read_text(encoding="utf-8"))
        return records


__all__ = ["{{class_name}}"]
