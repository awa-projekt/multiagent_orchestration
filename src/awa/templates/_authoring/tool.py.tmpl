"""The `{{name}}` tool: looks up the status of a record in the records its deps hold.

Generated by `awa new tool`. The function's docstring is what the model reads
(the `Args:` entries describe each argument) and its type hints are the
argument schema. `ctx` is filled in at run time and hidden from the model:
`ctx.deps` is whatever the caller passes as `agent.run(..., deps=...)`, so the
same tool works on the sample records below, on records you load, or on a
client for your system that you put in the deps.
Test it with `pytest tests/test_{{name}}.py`, or call it once with
`awa tools call {{name}}.py {{name}} --args '{"record_id": "R-1"}' --deps {{class_name}}Deps`.
"""

from __future__ import annotations

from dataclasses import dataclass, field

from awa import RunContext
from awa.tools import tool


@dataclass
class {{class_name}}Deps:
    """What the tool needs at run time: the records it looks up, by id."""

    records: dict[str, str] = field(default_factory=lambda: {"R-1": "open", "R-2": "closed"})


@tool({{options}})
{{async_prefix}}def {{name}}(ctx: RunContext[{{class_name}}Deps], record_id: str) -> str:
    """Look up the status of a record by its id. Use it whenever a request names a record.

    Args:
        record_id: The id of the record, for example "R-1".
    """

    status = ctx.deps.records.get(record_id)
    if status is None:
        raise KeyError(f"unknown record {record_id!r}")
    return f"Record {record_id} is {status}."


__all__ = ["{{class_name}}Deps", "{{name}}"]
