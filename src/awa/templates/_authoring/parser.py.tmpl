"""An own reader for {{kind}} files: it replaces (or adds) the parser of the file kind `{{kind}}`.

Generated by `awa new parser`. A parser gets the file and a context whose `ctx.profile` already
holds the file's identity (id, path, sha256, size, kind); it adds what it learns and returns
that profile. Rules: never raise for bad content (return `ctx.fail(code, message)`), never run
or fetch anything found in the file, cut text to `ctx.limits.max_chars_per_cell`, and call
`ctx.check_deadline()` in long loops.

Test it with `pytest tests/test_{{kind}}_parser.py`, then add
`register("parsers", "{{kind}}", profile_{{kind}}, replace=True)` to the project's `plugins.py`.
"""

from __future__ import annotations

{{imports}}
KINDS = ("{{kind}}",)
_HEAD_LINES = 5


def profile_{{kind}}(path: Path, ctx: ParseContext) -> FileProfile:
    """Profile a {{kind}} file as {{reads}}."""

    if ctx.profile.size == 0:
        return ctx.fail("DF-E-EMPTY", "the file is empty")
    text = path.read_bytes().decode("utf-8", errors="replace")
    ctx.check_deadline()
    lines = text.splitlines()
    limit = ctx.limits.max_chars_per_cell
    ctx.profile.text = TextInfo(
        encoding="utf-8",
        newline="crlf" if "\r\n" in text else "lf",
        bom=text.startswith("\ufeff"),
        lines=len(lines),
        head=[line[:limit] for line in lines[:_HEAD_LINES]],
        tail=[],
    )
{{tables}}    return ctx.profile


__all__ = ["KINDS", "profile_{{kind}}"]
