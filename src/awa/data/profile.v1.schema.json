{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "ColumnProfile": {
      "additionalProperties": false,
      "description": "One column of a table, with the decisions the profiler took about its values.",
      "properties": {
        "name": {
          "description": "The header cell as written (or `A`, `B`, ... without header).",
          "title": "Name",
          "type": "string"
        },
        "key": {
          "description": "`column_key(name)`, made unique within the table.",
          "title": "Key",
          "type": "string"
        },
        "index": {
          "description": "0-based position in the table.",
          "minimum": 0,
          "title": "Index",
          "type": "integer"
        },
        "type": {
          "default": "text",
          "enum": [
            "text",
            "integer",
            "decimal",
            "date",
            "datetime",
            "time",
            "bool",
            "id",
            "enum",
            "empty",
            "mixed"
          ],
          "title": "Type",
          "type": "string"
        },
        "declared_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Type declared by the source (SQLite).",
          "title": "Declared Type"
        },
        "nullable": {
          "default": false,
          "title": "Nullable",
          "type": "boolean"
        },
        "null_share": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Null Share",
          "type": "number"
        },
        "distinct": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Distinct"
        },
        "unique": {
          "default": false,
          "title": "Unique",
          "type": "boolean"
        },
        "format": {
          "anyOf": [
            {
              "$ref": "#/$defs/NumberFormat"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "date_format": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Pattern such as `DD.MM.YYYY`.",
          "title": "Date Format"
        },
        "ambiguous": {
          "default": false,
          "description": "True when no value rules out the other reading.",
          "title": "Ambiguous",
          "type": "boolean"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Unit hint from the header (`EUR`, `kg`, `%`).",
          "title": "Unit"
        },
        "min": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min"
        },
        "max": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max"
        },
        "top": {
          "items": {
            "$ref": "#/$defs/TopValue"
          },
          "title": "Top",
          "type": "array"
        },
        "examples": {
          "description": "Values as written in the file.",
          "items": {
            "type": "string"
          },
          "title": "Examples",
          "type": "array"
        },
        "pii": {
          "$ref": "#/$defs/PiiInfo"
        },
        "flags": {
          "description": "Codes of the flags that concern this column.",
          "items": {
            "type": "string"
          },
          "title": "Flags",
          "type": "array"
        }
      },
      "required": [
        "name",
        "key",
        "index"
      ],
      "title": "ColumnProfile",
      "type": "object"
    },
    "DocxInfo": {
      "additionalProperties": false,
      "description": "Facts of a Word document: outline, tables, review marks and an excerpt.",
      "properties": {
        "paragraphs": {
          "default": 0,
          "title": "Paragraphs",
          "type": "integer"
        },
        "text_length": {
          "default": 0,
          "title": "Text Length",
          "type": "integer"
        },
        "headings": {
          "items": {
            "$ref": "#/$defs/Heading"
          },
          "title": "Headings",
          "type": "array"
        },
        "tables": {
          "items": {
            "$ref": "#/$defs/DocxTable"
          },
          "title": "Tables",
          "type": "array"
        },
        "headers_footers": {
          "default": false,
          "title": "Headers Footers",
          "type": "boolean"
        },
        "tracked_changes": {
          "default": 0,
          "title": "Tracked Changes",
          "type": "integer"
        },
        "comments": {
          "default": 0,
          "title": "Comments",
          "type": "integer"
        },
        "images": {
          "default": 0,
          "title": "Images",
          "type": "integer"
        },
        "language": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Language"
        },
        "excerpt": {
          "default": "",
          "description": "Text at the start; untrusted data.",
          "title": "Excerpt",
          "type": "string"
        }
      },
      "title": "DocxInfo",
      "type": "object"
    },
    "DocxTable": {
      "additionalProperties": false,
      "description": "A table inside a Word document.",
      "properties": {
        "rows": {
          "default": 0,
          "title": "Rows",
          "type": "integer"
        },
        "columns": {
          "default": 0,
          "title": "Columns",
          "type": "integer"
        },
        "header": {
          "items": {
            "type": "string"
          },
          "title": "Header",
          "type": "array"
        }
      },
      "title": "DocxTable",
      "type": "object"
    },
    "FileProfile": {
      "additionalProperties": false,
      "description": "One file: identity, status, the tables found and one facts block for its kind.\n\n`status` is `ok`, `partial` (a limit cut the profile), `error` (see `flags`) or `unsupported`.\n`path` is relative to the profiled root; `source` is the path the file was read from.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "size": {
          "minimum": 0,
          "title": "Size",
          "type": "integer"
        },
        "kind": {
          "enum": [
            "csv",
            "xlsx",
            "pdf",
            "docx",
            "mail",
            "json",
            "sqlite",
            "text",
            "image",
            "zip",
            "unknown"
          ],
          "title": "Kind",
          "type": "string"
        },
        "detected_by": {
          "default": "content",
          "enum": [
            "content",
            "extension"
          ],
          "title": "Detected By",
          "type": "string"
        },
        "status": {
          "default": "ok",
          "enum": [
            "ok",
            "partial",
            "error",
            "unsupported"
          ],
          "title": "Status",
          "type": "string"
        },
        "role_hint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role Hint"
        },
        "mtime": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mtime"
        },
        "text": {
          "anyOf": [
            {
              "$ref": "#/$defs/TextInfo"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "tables": {
          "items": {
            "$ref": "#/$defs/TableProfile"
          },
          "title": "Tables",
          "type": "array"
        },
        "xlsx": {
          "anyOf": [
            {
              "$ref": "#/$defs/XlsxInfo"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "pdf": {
          "anyOf": [
            {
              "$ref": "#/$defs/PdfInfo"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "docx": {
          "anyOf": [
            {
              "$ref": "#/$defs/DocxInfo"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "mail": {
          "anyOf": [
            {
              "$ref": "#/$defs/MailInfo"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "json_doc": {
          "anyOf": [
            {
              "$ref": "#/$defs/JsonInfo"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "sqlite": {
          "anyOf": [
            {
              "$ref": "#/$defs/SqliteInfo"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "children": {
          "description": "Profiles of embedded files (mail attachments).",
          "items": {
            "$ref": "#/$defs/FileProfile"
          },
          "title": "Children",
          "type": "array"
        },
        "relations": {
          "items": {
            "$ref": "#/$defs/Relation"
          },
          "title": "Relations",
          "type": "array"
        },
        "flags": {
          "items": {
            "$ref": "#/$defs/Flag"
          },
          "title": "Flags",
          "type": "array"
        }
      },
      "required": [
        "id",
        "path",
        "sha256",
        "size",
        "kind"
      ],
      "title": "FileProfile",
      "type": "object"
    },
    "Flag": {
      "additionalProperties": false,
      "description": "A fact or decision the profiler wants a person (or a validator) to know about.\n\n`code` is `DF-<family>-<NAME>`; the severity follows the family, so build flags with\n`make_flag`.",
      "properties": {
        "code": {
          "pattern": "^DF-[IWE]-[A-Z0-9]+(?:-[A-Z0-9]+)*$",
          "title": "Code",
          "type": "string"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ],
          "title": "Severity",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "where": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Id of the file, table or column concerned.",
          "title": "Where"
        }
      },
      "required": [
        "code",
        "severity",
        "message"
      ],
      "title": "Flag",
      "type": "object"
    },
    "ForeignKey": {
      "additionalProperties": false,
      "description": "A declared foreign key of a SQLite database.",
      "properties": {
        "table": {
          "title": "Table",
          "type": "string"
        },
        "columns": {
          "items": {
            "type": "string"
          },
          "title": "Columns",
          "type": "array"
        },
        "ref_table": {
          "title": "Ref Table",
          "type": "string"
        },
        "ref_columns": {
          "items": {
            "type": "string"
          },
          "title": "Ref Columns",
          "type": "array"
        }
      },
      "required": [
        "table",
        "columns",
        "ref_table",
        "ref_columns"
      ],
      "title": "ForeignKey",
      "type": "object"
    },
    "Heading": {
      "additionalProperties": false,
      "description": "One heading of a Word document.",
      "properties": {
        "level": {
          "minimum": 1,
          "title": "Level",
          "type": "integer"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "level",
        "text"
      ],
      "title": "Heading",
      "type": "object"
    },
    "JsonField": {
      "additionalProperties": false,
      "description": "A path of a JSON document with the types and optionality seen over the records.",
      "properties": {
        "path": {
          "description": "`lines[].sku`: `[]` marks array items.",
          "title": "Path",
          "type": "string"
        },
        "types": {
          "description": "`string`, `number`, `null`, ...",
          "items": {
            "type": "string"
          },
          "title": "Types",
          "type": "array"
        },
        "optional_share": {
          "default": 0.0,
          "description": "Share of records without it.",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Optional Share",
          "type": "number"
        },
        "enum": {
          "items": {
            "type": "string"
          },
          "title": "Enum",
          "type": "array"
        },
        "format": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "`iso_datetime`, `epoch_ms`, ...",
          "title": "Format"
        }
      },
      "required": [
        "path"
      ],
      "title": "JsonField",
      "type": "object"
    },
    "JsonInfo": {
      "additionalProperties": false,
      "description": "Schema inferred over the records of a JSON or JSONL file.",
      "properties": {
        "top_level": {
          "default": "object",
          "enum": [
            "object",
            "array",
            "jsonl",
            "scalar"
          ],
          "title": "Top Level",
          "type": "string"
        },
        "records": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Records"
        },
        "depth": {
          "default": 0,
          "title": "Depth",
          "type": "integer"
        },
        "sampled": {
          "default": false,
          "title": "Sampled",
          "type": "boolean"
        },
        "paths": {
          "items": {
            "$ref": "#/$defs/JsonField"
          },
          "title": "Paths",
          "type": "array"
        },
        "key_variants": {
          "description": "Spellings of one name, `customerId` and `customer_id`.",
          "items": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Key Variants",
          "type": "array"
        }
      },
      "title": "JsonInfo",
      "type": "object"
    },
    "KeyValue": {
      "additionalProperties": false,
      "description": "A recognized field of a document: an IBAN, a date, an amount, an invoice number.",
      "properties": {
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Key"
        },
        "value": {
          "title": "Value",
          "type": "string"
        },
        "page": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "KeyValue",
      "type": "object"
    },
    "Limits": {
      "additionalProperties": false,
      "description": "What the profiler may spend per run; zero or negative values raise `ValidationError`.",
      "properties": {
        "max_files": {
          "default": 500,
          "description": "Most files in one run.",
          "minimum": 1,
          "title": "Max Files",
          "type": "integer"
        },
        "max_file_bytes": {
          "default": 100000000,
          "description": "Largest single file.",
          "minimum": 1,
          "title": "Max File Bytes",
          "type": "integer"
        },
        "max_total_bytes": {
          "default": 1000000000,
          "description": "Largest sum of all files.",
          "minimum": 1,
          "title": "Max Total Bytes",
          "type": "integer"
        },
        "max_rows_exact": {
          "default": 200000,
          "description": "Up to here rows are counted exactly.",
          "minimum": 1,
          "title": "Max Rows Exact",
          "type": "integer"
        },
        "sample_rows": {
          "default": 5000,
          "description": "Reservoir sample beyond max_rows_exact.",
          "minimum": 1,
          "title": "Sample Rows",
          "type": "integer"
        },
        "max_sheets": {
          "default": 50,
          "description": "Most sheets profiled per workbook.",
          "minimum": 1,
          "title": "Max Sheets",
          "type": "integer"
        },
        "max_pdf_pages_profiled": {
          "default": 50,
          "description": "Pages analyzed in detail.",
          "minimum": 1,
          "title": "Max Pdf Pages Profiled",
          "type": "integer"
        },
        "max_pdf_pages": {
          "default": 2000,
          "description": "Larger PDFs are refused.",
          "minimum": 1,
          "title": "Max Pdf Pages",
          "type": "integer"
        },
        "max_chars_per_cell": {
          "default": 200,
          "description": "Longer values are cut.",
          "minimum": 1,
          "title": "Max Chars Per Cell",
          "type": "integer"
        },
        "parse_timeout_s": {
          "default": 30.0,
          "description": "Seconds per file.",
          "exclusiveMinimum": 0,
          "title": "Parse Timeout S",
          "type": "number"
        },
        "max_zip_entries": {
          "default": 500,
          "description": "Most entries in an archive.",
          "minimum": 1,
          "title": "Max Zip Entries",
          "type": "integer"
        },
        "max_zip_ratio": {
          "default": 100,
          "description": "Largest unpack ratio of one entry.",
          "minimum": 1,
          "title": "Max Zip Ratio",
          "type": "integer"
        }
      },
      "title": "Limits",
      "type": "object"
    },
    "ListValidation": {
      "additionalProperties": false,
      "description": "A dropdown list of a worksheet: the allowed values are a free enum definition.",
      "properties": {
        "range": {
          "title": "Range",
          "type": "string"
        },
        "values": {
          "items": {
            "type": "string"
          },
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "range",
        "values"
      ],
      "title": "ListValidation",
      "type": "object"
    },
    "MailAttachment": {
      "additionalProperties": false,
      "description": "An attachment of a message; its own profile is a child of the mail file.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "content_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Type"
        },
        "size": {
          "default": 0,
          "title": "Size",
          "type": "integer"
        },
        "file_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Id of the child FileProfile, if profiled.",
          "title": "File Id"
        }
      },
      "required": [
        "name"
      ],
      "title": "MailAttachment",
      "type": "object"
    },
    "MailInfo": {
      "additionalProperties": false,
      "description": "Facts of a mail file: the messages (at most a sample of a large mailbox).",
      "properties": {
        "messages_total": {
          "default": 0,
          "title": "Messages Total",
          "type": "integer"
        },
        "messages": {
          "items": {
            "$ref": "#/$defs/MailMessage"
          },
          "title": "Messages",
          "type": "array"
        },
        "sampled": {
          "default": false,
          "title": "Sampled",
          "type": "boolean"
        }
      },
      "title": "MailInfo",
      "type": "object"
    },
    "MailMessage": {
      "additionalProperties": false,
      "description": "One message of an `.eml` or `.mbox` file. Header values and the body are untrusted.",
      "properties": {
        "index": {
          "minimum": 1,
          "title": "Index",
          "type": "integer"
        },
        "headers": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "from, to, cc, subject, date, message_id, in_reply_to",
          "title": "Headers",
          "type": "object"
        },
        "content_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Type"
        },
        "body_kind": {
          "default": "none",
          "enum": [
            "plain",
            "html",
            "both",
            "none"
          ],
          "title": "Body Kind",
          "type": "string"
        },
        "attachments": {
          "items": {
            "$ref": "#/$defs/MailAttachment"
          },
          "title": "Attachments",
          "type": "array"
        },
        "language": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Language"
        },
        "excerpt": {
          "default": "",
          "title": "Excerpt",
          "type": "string"
        },
        "injection_suspected": {
          "default": false,
          "title": "Injection Suspected",
          "type": "boolean"
        }
      },
      "required": [
        "index"
      ],
      "title": "MailMessage",
      "type": "object"
    },
    "NumberFormat": {
      "additionalProperties": false,
      "description": "How the numbers of a column are written.",
      "properties": {
        "decimal": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Decimal separator, `,` or `.`.",
          "title": "Decimal"
        },
        "thousands": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Thousands separator, if any.",
          "title": "Thousands"
        },
        "currency": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
